# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fit Lab: simulation workshop, notes and tools (not part of the website)
/blender/
/blender_codex/
/docs/
/reports/
/research_notes/
/.archify/
/app/api/fitlab/
*.pdf
/err.txt
/repo.txt
/.shot.png
/*.png.webp
/Adobe Express*

# Fit Lab 3D files the website does not load (it loads the packed .glb.gz: blender/pack_web.sh)
# Layout: bodies/ = shared by every brand; brands/<brand>/<style>/ = that garment's files
/public/models/fitlab/exact/
/public/models/fitlab/brands/tnt_co/gon_tee/prototype/
/public/models/fitlab/brands/tnt_co/gon_tee/videos/
# Catwalk playback loads losslessly packed .bin.gz; retain originals locally.
/public/models/fitlab/bodies/walk/*.bin
/public/models/fitlab/brands/tnt_co/gon_tee/walk/*.bin
/public/models/fitlab/brands/tnt_co/xin_jeans/walk/*.bin
/public/models/fitlab/brands/tnt_co/gon_tee/grid/*.glb
/public/models/fitlab/brands/tnt_co/xin_jeans/grid/**/*.glb
/public/models/fitlab/brands/tnt_co/xin_jeans/grid/jeans_*.glb.gz
/public/models/fitlab/brands/*/*/belt/*.glb
/public/models/fitlab/brands/*/*/drop/*.glb
# hidden products (not shown on the site yet)
/public/models/fitlab/brands/tnt_co/xin_jeans/xin_check/
/public/models/fitlab/brands/tnt_co/stallion_brown/

# Product catwalks load packed files, with raw exports retained locally.
/public/models/fitlab/brands/*/*/walk/*.bin
/public/models/fitlab/brands/tnt_co/ns_matrix_white/walk/*.glb
